{
  "name": "@exam-sync/db",
  "private": true,
  "version": "0.0.0",
  "description": "Prisma schema + migrations — source of truth for ARCHITECTURE.md §AC.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
