{
  "name": "exam-sync",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" \"workers/**/*.ts\" && npm run lint:boundaries",
    "lint:boundaries": "node scripts/check-module-boundaries.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
