{
  "name": "@exam-sync/api",
  "private": true,
  "version": "0.0.0",
  "description": "Exam-Sync API — modular monolith (ARCHITECTURE.md §AW, ADR-001)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest && npm run test:e2e",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "load-test:seed": "ts-node load-tests/seed-load-test-data.ts",
    "load-test:cleanup": "ts-node load-tests/cleanup-load-test-data.ts",
    "load-test:run": "ts-node load-tests/run-scenario.ts"
  },
  "dependencies": {
    "@exam-sync/db": "*",
    "@exam-sync/domain-logic": "*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^5.2.0",
    "argon2": "^0.40.3",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.8.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "multer": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
