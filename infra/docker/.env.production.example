# Copy to .env.production (same directory) and fill in real values.
# Never commit .env.production — names only here, no real values.
#
# Used by: docker compose -f infra/docker/docker-compose.prod.yml --env-file infra/docker/.env.production up

# --- postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- api (apps/api) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ALLOWED_ORIGINS=
# DATABASE_URL and REDIS_URL are assembled inside docker-compose.prod.yml
# from the postgres/redis service names + the vars above — not set directly
# here, so there is exactly one place a DB/Redis hostname is decided.

# --- web (apps/web) ---
# Baked into the client bundle at build time (Next.js NEXT_PUBLIC_* rule) —
# the public URL browsers will call, e.g. https://api.yourdomain.example
NEXT_PUBLIC_API_URL=
