# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# No secrets are committed to this repository (Phase 0 security check —
# IMPLEMENTATION_PLAN.md Phase 0 "Security checks").

NODE_ENV=development
PORT=3000

# PostgreSQL (ARCHITECTURE.md §AV) — no domain tables exist yet in Phase 0,
# this only wires the connection for Phase 1+.
DATABASE_URL=postgresql://exam_sync:exam_sync@localhost:5432/exam_sync?schema=public

# Redis (cache + rate-limit store only, per docs/adr/009-caching-strategy.md —
# never a source of truth).
REDIS_URL=redis://localhost:6379

# JWT (wired for real in Phase 1 — placeholder here so config module has a
# documented shape from Phase 0).
JWT_ACCESS_SECRET=changeme-local-dev-only
JWT_REFRESH_SECRET=changeme-local-dev-only

# CORS allowlist for apps/web (Phase 2 — comma-separated, no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3001

# apps/web only: the API base URL the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:3000
